            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>TO-BE trigger; review case history to distinguish first revalidation from repeated validation rework</text>
    </textAnnotation>
    <textAnnotation id="Note_Control">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#F7F2FF" />
            <bizagi:BizagiProperty name="borderColor" value="#6F42C1" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Repeated-rework cases are routed through consolidated resolution and a readiness check before another revalidation attempt; unresolved cases are escalated instead of cycling directly back.</text>
    </textAnnotation>
