            <bizagi:BizagiProperty name="textDirection" value="Horizontal" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Repeated-rework cases undergo consolidated resolution and a readiness check before revalidation.</text>
    </textAnnotation>
    <textAnnotation id="Note_Trigger">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
