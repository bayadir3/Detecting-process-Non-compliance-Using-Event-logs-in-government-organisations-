# ------------------------------------------------------------
# 4.7.2 Lifecycle Reconstruction
# Queue Time      = schedule -> start
# Active Time     = start/resume -> suspend/complete/abort/withdraw
# Suspension Time = suspend -> resume/complete/abort/withdraw
# Total Cycle     = schedule -> first end event
# ------------------------------------------------------------

print("\n4.7.2 Lifecycle Reconstruction")

workflow_df = df_discovery[
    df_discovery[ACTIVITY].str.startswith("W_", na=False)
].copy()

workflow_df = workflow_df.sort_values(
    [CASE, ACTIVITY, TIME, "_event_order"],
    kind="stable",
)

workflow_df["Occurrence_ID"] = (
    workflow_df
    .groupby([CASE, ACTIVITY], sort=False)[LIFECYCLE]
    .transform(lambda x: x.eq("schedule").cumsum())
)

workflow_df = workflow_df[
    workflow_df["Occurrence_ID"] > 0
].copy()

occurrence_cols = [CASE, ACTIVITY, "Occurrence_ID"]
occ_group = workflow_df.groupby(occurrence_cols, sort=False)

workflow_df["Next_Lifecycle"] = occ_group[LIFECYCLE].shift(-1)
workflow_df["Next_Timestamp"] = occ_group[TIME].shift(-1)
workflow_df["Segment_Hours"] = (
    workflow_df["Next_Timestamp"]
    - workflow_df[TIME]
).dt.total_seconds() / 3600

active_mask = (
    workflow_df[LIFECYCLE].isin(["start", "resume"])
    & workflow_df["Next_Lifecycle"].isin(
        ["suspend", "complete", "ate_abort", "withdraw"]
    )
)

workflow_df["Active_Segment_Hours"] = (
    workflow_df["Segment_Hours"].where(active_mask, 0.0)
)

suspension_mask = (
    workflow_df[LIFECYCLE].eq("suspend")
    & workflow_df["Next_Lifecycle"].isin(
        ["resume", "complete", "ate_abort", "withdraw"]
    )
)

workflow_df["Suspension_Segment_Hours"] = (
    workflow_df["Segment_Hours"].where(suspension_mask, 0.0)
)

occurrences = (
    workflow_df[workflow_df[LIFECYCLE].eq("schedule")]
    .groupby(occurrence_cols, as_index=False)[TIME]
    .min()
    .rename(columns={TIME: "Schedule_Time"})
)

start_times = (
    workflow_df[workflow_df[LIFECYCLE].eq("start")]
    .groupby(occurrence_cols, as_index=False)[TIME]
    .min()
    .rename(columns={TIME: "Start_Time"})
)

end_events = (
    workflow_df[
        workflow_df[LIFECYCLE].isin(
            ["complete", "ate_abort", "withdraw"]
        )
    ]
    .sort_values(
        occurrence_cols + [TIME, "_event_order"],
        kind="stable",
    )
)

first_end = (
    end_events
    .groupby(occurrence_cols, sort=False)
    .head(1)[occurrence_cols + [TIME, LIFECYCLE]]
    .rename(
        columns={
            TIME: "End_Time",
            LIFECYCLE: "End_Status",
        }
    )
)

active_totals = (
    workflow_df
    .groupby(occurrence_cols, as_index=False)["Active_Segment_Hours"]
    .sum()
    .rename(
        columns={
            "Active_Segment_Hours": "Active_Processing_Hours"
        }
    )
)

suspension_totals = (
    workflow_df
    .groupby(occurrence_cols, as_index=False)["Suspension_Segment_Hours"]
    .sum()
    .rename(
        columns={
            "Suspension_Segment_Hours": "Suspension_Time_Hours"
        }
    )
)

occurrences = (
    occurrences
    .merge(start_times, on=occurrence_cols, how="left")
    .merge(first_end, on=occurrence_cols, how="left")
    .merge(active_totals, on=occurrence_cols, how="left")
    .merge(suspension_totals, on=occurrence_cols, how="left")
)

occurrences["Queue_Time_Hours"] = (
    occurrences["Start_Time"]
    - occurrences["Schedule_Time"]
).dt.total_seconds() / 3600

occurrences["Total_Cycle_Hours"] = (
    occurrences["End_Time"]
    - occurrences["Schedule_Time"]
).dt.total_seconds() / 3600


# ------------------------------------------------------------
# 4.7.3 Lifecycle Bottleneck Results
# ------------------------------------------------------------

print("\n4.7.3 Lifecycle Bottleneck Results")

completed_occurrences = occurrences[
