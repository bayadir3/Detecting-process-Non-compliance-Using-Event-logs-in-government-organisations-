# ------------------------------------------------------------
# 4.7.1 High-Level Bottlenecks
# Measures elapsed time between consecutive business-level events.
# ------------------------------------------------------------

print("\n4.7.1 High-Level Bottlenecks")

bottleneck_df = business_df[
    [CASE, ACTIVITY, TIME, "_event_order"]
].copy()

bottleneck_df = bottleneck_df.sort_values(
    [CASE, TIME, "_event_order"],
    kind="stable",
)

case_group = bottleneck_df.groupby(CASE, sort=False)

bottleneck_df["Next_Activity"] = case_group[ACTIVITY].shift(-1)
bottleneck_df["Next_Timestamp"] = case_group[TIME].shift(-1)

bottleneck_df["Elapsed_Days"] = (
    bottleneck_df["Next_Timestamp"]
    - bottleneck_df[TIME]
).dt.total_seconds() / 86400

bottleneck_valid = bottleneck_df.dropna(
    subset=["Next_Activity", "Elapsed_Days"]
).copy()

transition_performance = (
    bottleneck_valid
    .groupby([ACTIVITY, "Next_Activity"])
    .agg(
        Frequency=("Elapsed_Days", "size"),
        Average_Elapsed_Days=("Elapsed_Days", "mean"),
        Median_Elapsed_Days=("Elapsed_Days", "median"),
        P90_Elapsed_Days=("Elapsed_Days", lambda x: x.quantile(0.90)),
    )
    .reset_index()
    .rename(columns={ACTIVITY: "From_Activity"})
)

MIN_FREQUENCY = 500
terminal_states = ["A_Cancelled", "A_Denied", "A_Pending"]

top_bottlenecks = (
    transition_performance[
        transition_performance["Frequency"] >= MIN_FREQUENCY
    ]
    .loc[lambda x: ~x["Next_Activity"].isin(terminal_states)]
    .sort_values("Average_Elapsed_Days", ascending=False)
    .head(10)
    .copy()
)

for col in [
    "Average_Elapsed_Days",
    "Median_Elapsed_Days",
    "P90_Elapsed_Days",
]:
    top_bottlenecks[col] = top_bottlenecks[col].round(2)

top_bottlenecks["Transition"] = (
    top_bottlenecks["From_Activity"]
    + " -> "
    + top_bottlenecks["Next_Activity"]
)

print(
    top_bottlenecks[
        [
            "Transition",
            "Frequency",
            "Average_Elapsed_Days",
            "Median_Elapsed_Days",
