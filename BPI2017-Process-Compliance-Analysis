    print("\n" + "=" * width)
    print(title)
    print("=" * width)


def locate_event_log():
    """Find the BPI Challenge 2017 XES file in common local/Colab locations."""
    candidates = []

    if "__file__" in globals():
        script_dir = Path(__file__).resolve().parent
        candidates.extend([
            script_dir / "BPI Challenge 2017.xes",
            script_dir / "BPI Challenge 2017.xes.gz",
        ])

    # Remove duplicates while preserving order.
    unique_candidates = []
    seen = set()
    for path in candidates:
        path_str = str(path)
        if path_str not in seen:
            unique_candidates.append(path)
            seen.add(path_str)

    for path in unique_candidates:
        if path.exists():
            return path

    searched = "\n".join(f"  - {p}" for p in unique_candidates)
    raise FileNotFoundError(
        "BPI Challenge 2017 event log was not found.\n"
        "Searched these locations:\n"
        f"{searched}"
    )


def rule_summary(rule_name, result_df, applicable_col="Applicable", compliant_col="Compliant"):
    """Create one standardized summary row for a case/offer-level compliance rule."""
    applicable_df = result_df[result_df[applicable_col].eq(True)].copy()
    applicable = len(applicable_df)
    compliant = applicable_df[compliant_col].eq(True).sum()
    deviations = applicable_df[compliant_col].eq(False).sum()
    rate = deviations / applicable * 100 if applicable else 0.0

    print(f"\n{rule_name}")
    print("-" * len(rule_name))
    print(f"Applicable units : {applicable:,}")
    print(f"Compliant units  : {compliant:,}")
    print(f"Deviations       : {deviations:,}")
    print(f"Deviation rate   : {rate:.2f}%")

    return {
        "Rule": rule_name,
        "Applicable": int(applicable),
        "Compliant": int(compliant),
        "Deviations": int(deviations),
        "Deviation_Rate_%": round(float(rate), 2),
    }


def safe_mean(series):
    """Return a float mean without failing on an empty Series."""
    return float(series.mean()) if len(series) else float("nan")


