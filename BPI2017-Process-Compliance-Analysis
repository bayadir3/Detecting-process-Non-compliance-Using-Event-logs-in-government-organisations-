print("\n5.3.1 Submission Before Processing")

a1_results = []

for case_id, case in business_df.groupby(CASE, sort=False):
    activities = case[ACTIVITY].tolist()

    if "W_Complete application" in activities:
        complete_pos = activities.index("W_Complete application")
        compliant = "A_Submitted" in activities[:complete_pos]
        applicable = True
    else:
        compliant = None
        applicable = False

    a1_results.append({
        "Unit_ID": case_id,
        "Applicable": applicable,
        "Compliant": compliant,
    })

a1_df = pd.DataFrame(a1_results)


# --------------------------------------------------------
# 5.3.2 Revalidation After Incomplete Status
# --------------------------------------------------------
print("\n5.3.2 Revalidation After Incomplete Status")

a2_results = []
positive_outcomes = ["O_Accepted", "A_Pending"]

for case_id, case in business_df.groupby(CASE, sort=False):
    activities = case[ACTIVITY].tolist()
    applicable = False
    compliant = True

    incomplete_positions = [
        i for i, act in enumerate(activities)
        if act == "A_Incomplete"
    ]

    for incomplete_pos in incomplete_positions:
        later_positive_positions = [
            i
            for i in range(incomplete_pos + 1, len(activities))
            if activities[i] in positive_outcomes
        ]

        if later_positive_positions:
            applicable = True
            outcome_pos = later_positive_positions[0]
            between = activities[incomplete_pos + 1:outcome_pos]

            if "W_Validate application" not in between:
                compliant = False
                break

    a2_results.append({
        "Unit_ID": case_id,
        "Applicable": applicable,
        "Compliant": compliant if applicable else None,
    })

a2_df = pd.DataFrame(a2_results)



section_53_compliance_summary = pd.DataFrame([
    rule_summary(
        "Submission Before Processing",
        a1_df,
    ),
    rule_summary(
        "Revalidation After Incomplete Status",
        a2_df,
    ),
])

