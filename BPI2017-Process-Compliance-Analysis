# ============================================================
# 5.1.2 RULES WITH DETECTED DEVIATIONS

# ============================================================

print("\n5.1.2 Rules with Detected Deviations")

detected_deviation_summary = []


# ------------------------------------------------------------
# R1 - Excessive Validation Delay
# Performance monitoring rule:
# A_Complete -> W_Validate application
# Cases exceeding the observed P90 are flagged.
# ------------------------------------------------------------

print("\nR1 - Excessive Validation Delay")

r1_transition_df = business_df[
    [CASE, ACTIVITY, TIME, "_event_order"]
].copy()

r1_transition_df = r1_transition_df.sort_values(
    [CASE, TIME, "_event_order"],
    kind="stable",
)

r1_group = r1_transition_df.groupby(CASE, sort=False)

r1_transition_df["Next_Activity"] = r1_group[ACTIVITY].shift(-1)
r1_transition_df["Next_Timestamp"] = r1_group[TIME].shift(-1)

r1_transition_df["Elapsed_Days"] = (
    r1_transition_df["Next_Timestamp"]
    - r1_transition_df[TIME]
).dt.total_seconds() / 86400

validation_transition = r1_transition_df[
    (r1_transition_df[ACTIVITY] == "A_Complete")
    & (r1_transition_df["Next_Activity"] == "W_Validate application")
].copy()

R1_P90_THRESHOLD_DAYS = validation_transition["Elapsed_Days"].quantile(0.90)
r1_average = validation_transition["Elapsed_Days"].mean()
r1_median = validation_transition["Elapsed_Days"].median()

validation_transition["Compliant"] = (
    validation_transition["Elapsed_Days"] <= R1_P90_THRESHOLD_DAYS
)

validation_transition["Reason"] = validation_transition.apply(
    lambda row: (
        ""
        if row["Compliant"]
        else (
            f"Validation delay of {row['Elapsed_Days']:.2f} days "
            f"exceeds P90 threshold of {R1_P90_THRESHOLD_DAYS:.2f} days"
        )
    ),
    axis=1,
)

r1_applicable = len(validation_transition)
r1_compliant = validation_transition["Compliant"].eq(True).sum()
r1_deviations = validation_transition["Compliant"].eq(False).sum()
r1_rate = r1_deviations / r1_applicable * 100 if r1_applicable else 0.0

r1_delayed_case_ids = validation_transition.loc[
    validation_transition["Compliant"].eq(False),
    CASE,
].unique()
r1_delayed_cases_count = len(r1_delayed_case_ids)

print("Transition: A_Complete -> W_Validate application")
print(f"Applicable transitions       : {r1_applicable:,}")
print(f"Average elapsed time         : {r1_average:.2f} days")
print(f"Median elapsed time          : {r1_median:.2f} days")
print(f"P90 threshold                : {R1_P90_THRESHOLD_DAYS:.2f} days")
print(f"Within threshold             : {r1_compliant:,}")
print(f"Excessive-delay transitions  : {r1_deviations:,}")
print(f"Cases with excessive delay   : {r1_delayed_cases_count:,}")
print(f"Performance deviation rate   : {r1_rate:.2f}%")

r1_violations = validation_transition[
    validation_transition["Compliant"].eq(False)
].copy()

if not r1_violations.empty:
    print("\nExample excessive-delay cases:")
    print(
        r1_violations[
            [CASE, ACTIVITY, "Next_Activity", "Elapsed_Days", "Reason"]
        ]
        .head(10)
        .to_string(index=False)
    )

detected_deviation_summary.append({
    "Rule": "R1 - Excessive Validation Delay (> observed P90)",
    "Applicable": int(r1_applicable),
    "Compliant": int(r1_compliant),
    "Deviations": int(r1_deviations),
    "Deviation_Rate_%": round(float(r1_rate), 2),
})


# ------------------------------------------------------------
# R2 - Mandatory Offer Transmission
# If a case reaches O_Create Offer, an offer-sending event should
# be recorded after creation before the case terminates.
# Accepted sending events:
#   - O_Sent (mail and online)
#   - O_Sent (online only)
# ------------------------------------------------------------

print("\nR2 - Mandatory Offer Transmission")

sending_activities = [
    "O_Sent (mail and online)",
    "O_Sent (online only)",
]

offer_creation = (
    business_df[business_df[ACTIVITY].eq("O_Create Offer")]
    .groupby(CASE)[TIME]
    .min()
    .rename("First_Offer_Creation")
)

offer_sending = (
    business_df[business_df[ACTIVITY].isin(sending_activities)]
    .groupby(CASE)[TIME]
    .max()
    .rename("Last_Offer_Sending")
)

offer_check = pd.concat(
    [offer_creation, offer_sending],
    axis=1,
).loc[offer_creation.index].copy()

offer_check["Compliant"] = (
    offer_check["Last_Offer_Sending"].notna()
    & (
        offer_check["Last_Offer_Sending"]
        > offer_check["First_Offer_Creation"]
    )
)

offer_not_sent = offer_check[
    offer_check["Compliant"].eq(False)
].copy()

r2_applicable = len(offer_check)
r2_compliant = offer_check["Compliant"].eq(True).sum()
r2_deviations = offer_check["Compliant"].eq(False).sum()
r2_rate = r2_deviations / r2_applicable * 100 if r2_applicable else 0.0
r2_deviating_case_ids = offer_not_sent.index.to_numpy()

# Use full raw case duration for report comparison.
raw_case_duration = (
    df_discovery
    .groupby(CASE)[TIME]
    .agg(Start_Time="min", End_Time="max")
)
raw_case_duration["Duration_Days"] = (
    raw_case_duration["End_Time"]
    - raw_case_duration["Start_Time"]
).dt.total_seconds() / 86400

r2_nc_avg_duration = raw_case_duration.loc[
    raw_case_duration.index.isin(r2_deviating_case_ids),
    "Duration_Days",
].mean()

r2_c_avg_duration = raw_case_duration.loc[
    raw_case_duration.index.isin(offer_check.index)
    & ~raw_case_duration.index.isin(r2_deviating_case_ids),
    "Duration_Days",
].mean()

print(f"Applicable cases (offer initiated)        : {r2_applicable:,}")
print(f"Compliant cases (offer sent)              : {r2_compliant:,}")
print(f"Cases with procedural deviation           : {r2_deviations:,}")
print(f"Structural non-compliance rate            : {r2_rate:.2f}%")
print(f"Average throughput time - compliant       : {r2_c_avg_duration:.2f} days")
print(f"Average throughput time - non-compliant   : {r2_nc_avg_duration:.2f} days")

detected_deviation_summary.append({
    "Rule": "R2 - Mandatory Offer Transmission",
    "Applicable": int(r2_applicable),
    "Compliant": int(r2_compliant),
    "Deviations": int(r2_deviations),
    "Deviation_Rate_%": round(float(r2_rate), 2),
})


# ------------------------------------------------------------
# R3 - Post-Acceptance Cancellation
# A cancellation recorded after A_Accepted is flagged for review.
# ------------------------------------------------------------

print("\nR3 - Post-Acceptance Cancellation")

accepted_time = (
    business_df[business_df[ACTIVITY].eq("A_Accepted")]
    .groupby(CASE)[TIME]
    .min()
    .rename("Accepted_Time")
)

cancelled_time = (
    business_df[business_df[ACTIVITY].eq("A_Cancelled")]
    .groupby(CASE)[TIME]
    .max()
    .rename("Cancelled_Time")
)

acceptance_check = pd.concat(
    [accepted_time, cancelled_time],
    axis=1,
).reindex(business_df[CASE].drop_duplicates()).copy()

acceptance_check["Deviation"] = (
    acceptance_check["Accepted_Time"].notna()
    & acceptance_check["Cancelled_Time"].notna()
    & (
        acceptance_check["Cancelled_Time"]
        > acceptance_check["Accepted_Time"]
    )
)

r3_deviating_case_ids = acceptance_check.index[
    acceptance_check["Deviation"].eq(True)
]

r3_applicable = total_cases
r3_deviations = len(r3_deviating_case_ids)
r3_compliant = r3_applicable - r3_deviations
r3_rate = r3_deviations / r3_applicable * 100 if r3_applicable else 0.0

r3_nc_avg_duration = raw_case_duration.loc[
    raw_case_duration.index.isin(r3_deviating_case_ids),
    "Duration_Days",
].mean()

r3_c_avg_duration = raw_case_duration.loc[
    ~raw_case_duration.index.isin(r3_deviating_case_ids),
    "Duration_Days",
].mean()

r3_delay_difference = r3_nc_avg_duration - r3_c_avg_duration

print(f"Total logged cases                         : {r3_applicable:,}")
print(f"Compliant cases                            : {r3_compliant:,}")
print(f"Cases requiring review                     : {r3_deviations:,}")
print(f"Review / deviation rate                    : {r3_rate:.2f}%")
print(f"Average throughput time - remaining cases  : {r3_c_avg_duration:.2f} days")
print(f"Average throughput time - review cohort    : {r3_nc_avg_duration:.2f} days")
print(f"Observed duration difference               : {r3_delay_difference:.2f} days")

detected_deviation_summary.append({
    "Rule": "R3 - Post-Acceptance Cancellation",
    "Applicable": int(r3_applicable),
    "Compliant": int(r3_compliant),
    "Deviations": int(r3_deviations),
    "Deviation_Rate_%": round(float(r3_rate), 2),
})


detected_deviation_summary_df = pd.DataFrame(
    detected_deviation_summary
)

print("\nSummary - Rules with Detected Deviations")
print(detected_deviation_summary_df.to_string(index=False))

detected_deviation_summary_df.to_csv(
    OUTPUT_DIR / "rules_with_detected_deviations.csv",
    index=False,
)


