    OUTPUT_DIR / "section_5_3_compliance_rules.csv",
    index=False,
)


# ------------------------------------------------------------
# 5.3.3 Skipped Approvals, Wrong Execution Orders, and Unauthorized Resources
# ------------------------------------------------------------
print("\n5.3.3 Procedural Execution and Authorization Summary")

# Preserve the original assignment logic so the results remain consistent with the report.
log_df = df_discovery.copy()
log_df["activity_lower"] = log_df[ACTIVITY].astype(str).str.lower()

submission_like_cases = log_df[
    log_df["activity_lower"].str.contains(
        "create|submit|app|request",
        na=False,
        regex=True,
    )
][CASE].unique()

approval_like_cases = log_df[
    log_df["activity_lower"].str.contains(
        "appr|accept|grant|confirm",
        na=False,
        regex=True,
    )
][CASE].unique()

skipped_approval_count = len(
    set(submission_like_cases) - set(approval_like_cases)
)

wrong_order_cases = []

for case_id, group in log_df.groupby(CASE, sort=False):
    group = group.sort_values(
        [TIME, "_event_order"],
        kind="stable",
    )
    activities_lower = group["activity_lower"].tolist()

    approval_indices = [
        i for i, act in enumerate(activities_lower)
        if any(k in act for k in ["appr", "accept", "grant", "confirm"])
    ]

    validation_indices = [
        i for i, act in enumerate(activities_lower)
        if any(k in act for k in ["val", "check", "review"])
    ]

    if approval_indices and validation_indices:
        if min(approval_indices) < min(validation_indices):
            wrong_order_cases.append(case_id)

wrong_order_count = len(set(wrong_order_cases))

resource_col = RESOURCE if RESOURCE in log_df.columns else next(
    (
        col for col in log_df.columns
        if "resource" in col.lower()
        or "org" in col.lower()
        or "user" in col.lower()
    ),
    None,
)

unauthorized_count = 0

if resource_col:
    unauthorized_values = {
        "unassigned",
        "unknown",
        "guest",
        "external",
    }

    unauthorized_cases = log_df[
        log_df[resource_col]
        .astype(str)
        .str.lower()
        .isin(unauthorized_values)
    ]

    unauthorized_count = unauthorized_cases[CASE].nunique()

procedural_checks = pd.DataFrame([
    {
        "Check": "Skipped Approvals",
        "Cases": skipped_approval_count,
    },
    {
        "Check": "Wrong Execution Orders",
        "Cases": wrong_order_count,
    },
    {
        "Check": "Unauthorized Resources",
        "Cases": unauthorized_count,
    },
])

print(procedural_checks.to_string(index=False))
procedural_checks.to_csv(
    OUTPUT_DIR / "procedural_execution_authorization_checks.csv",
    index=False,
)


