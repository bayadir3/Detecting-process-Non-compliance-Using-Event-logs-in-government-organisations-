    .agg(
        Completed_Occurrences=("Occurrence_ID", "size"),
        Avg_Queue_Hours=("Queue_Time_Hours", "mean"),
        Avg_Active_Processing_Hours=("Active_Processing_Hours", "mean"),
        Avg_Suspension_Hours=("Suspension_Time_Hours", "mean"),
        Avg_Total_Cycle_Hours=("Total_Cycle_Hours", "mean"),
    )
    .reset_index()
)

